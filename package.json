{
  "name": "connect",
  "private": true,
  "type": "module",
  "scripts": {
    "backend:build": "pnpm run --filter @connect/backend build",
    "frontend:build": "pnpm run --filter @connect/frontend build",
    "backend:build:check": "pnpm run --filter @connect/backend build:check",
    "frontend:build:check": "pnpm run --filter @connect/frontend build:check",
    "backend:dev": "pnpm run --filter @connect/backend dev",
    "frontend:dev": "pnpm run --filter @connect/frontend dev",
    "backend:lint": "pnpm run --filter @connect/backend lint",
    "frontend:lint": "pnpm run --filter @connect/frontend lint",
    "backend:format:check": "pnpm run --filter @connect/backend format:check",
    "frontend:format:check": "pnpm run --filter @connect/frontend format:check",
    "backend:format:write": "pnpm run --filter @connect/backend format:write",
    "frontend:format:write": "pnpm run --filter @connect/frontend format:write",
    "prepare": "husky",
    "pre-commit": "lint-staged -c lint-staged.config.js"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
