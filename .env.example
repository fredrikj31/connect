# DEVELOPMENT
API_HOST=0.0.0.0
API_PORT=3000
AUTH_BASE_URL=http://127.0.0.1:3000/api/auth
AUTH_SECRET= # Random generated string with high entropy (must be at least 32 characters)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER= # Random generated string
DATABASE_PASSWORD= # Random generated string
DATABASE_NAME=connect
WEBSITE_BASE_URL=http://127.0.0.1:5173 # Must be the exact origin typed in the browser: localhost vs 127.0.0.1 breaks CORS and the session cookie
VITE_API_BASE_URL=http://127.0.0.1:3000/api
VITE_ASSETS_BASE_URL=http://127.0.0.1:8000 # Where the frontend loads profile pictures from (dev-assets nginx)
UPLOADS_FILE_PATH=../.docker/assets # Where the backend writes uploads (relative to the backend package), served by dev-assets
# VITE_APP_VERSION=dev # Optional, exposed as config.app.version. Set automatically by the release workflow in production

# PRODUCTION
COMPOSE_PROFILES=prod
BACKEND_PORT=5001
FRONTEND_PORT=5002
ASSETS_PORT=5003
AUTH_BASE_URL=https://<REPLACE WITH HOST>/api/auth
AUTH_SECRET= # Random generated string with high entropy (must be at least 32 characters)
DATABASE_PORT=5000
DATABASE_USER= # Random generated string
DATABASE_PASSWORD= # Random generated string
MY_APP_API_BASE_URL=https://<REPLACE WITH HOST>/api
MY_APP_ASSETS_BASE_URL=https://<REPLACE WITH ASSETS HOST>
WEBSITE_BASE_URL=https://<REPLACE WITH HOST>
